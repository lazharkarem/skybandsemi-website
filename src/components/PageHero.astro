---
import CircuitField from './CircuitField.astro'

interface Props {
  eyebrow: string
  title: string
  lead: string
  current: string
  tone?: 'dark' | 'light'
}

const { eyebrow, title, lead, current, tone = 'dark' } = Astro.props
---

<section class:list={['page-hero', `page-hero--${tone}`]}>
  <div class="page-hero-grid" aria-hidden="true"></div>
  <CircuitField />
  <div class="container page-hero-inner">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{current}</span>
    </nav>
    <div class="page-hero-copy" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{lead}</p>
    </div>
    <slot name="visual" />
  </div>
</section>
