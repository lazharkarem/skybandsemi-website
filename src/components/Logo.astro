---
interface Props {
  class?: string
  compact?: boolean
}

const { class: className = '', compact = false } = Astro.props
---

<svg class:list={['brand-logo', className]} viewBox={compact ? '0 0 48 52' : '0 0 304 52'} aria-hidden="true">
  <g transform="skewX(-10)">
    <rect x="4" y="18" width="9" height="31" rx="1" fill="currentColor" opacity=".62"></rect>
    <rect x="19" y="10" width="9" height="39" rx="1" fill="#52c7bf"></rect>
    <rect x="34" y="2" width="9" height="47" rx="1" fill="#8de2da"></rect>
  </g>
  <path d="M3 50H45" fill="none" stroke="#8de2da" stroke-width="1.5"></path>
  {!compact && (
    <>
      <text x="62" y="31" font-family="Manrope Variable, Manrope, sans-serif" font-weight="720" font-size="27" letter-spacing="-1.1" fill="currentColor">SkyBand</text>
      <text x="63" y="44" font-family="IBM Plex Mono, monospace" font-weight="500" font-size="7" letter-spacing="2.2" fill="#8de2da">SEMICONDUCTORS</text>
    </>
  )}
</svg>
