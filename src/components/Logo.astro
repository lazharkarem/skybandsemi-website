---
interface Props {
  class?: string;
  compact?: boolean;
  width?: number | string;
  height?: number | string;
  title?: string;
}

const {
  class: className = "",
  compact = false,
  title = "SkyBand Semiconductors",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<img
  src={`${base}SkyBand_logo_transparent.png`}
  alt="SkyBand Semiconductors Logo"
  class:list={["brand-logo", className]}
/>