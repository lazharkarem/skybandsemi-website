---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import SectionHeader from '../components/SectionHeader.astro'
import CtaBand from '../components/CtaBand.astro'
import CircuitField from '../components/CircuitField.astro'
import WaveTrace from '../components/WaveTrace.astro'

const base = import.meta.env.BASE_URL

const engagements = [
  {
    number: '01',
    title: 'Consulting & engineering',
    text: 'Focused RF expertise embedded in your team, from architecture and feasibility through design review and validation.',
    href: `${base}capabilities/`,
    link: 'Explore capabilities',
    icon: 'consulting',
  },
  {
    number: '02',
    title: 'Full project development',
    text: 'One continuous engineering path from requirements and circuit design through tape-out, packaging and hardware validation.',
    href: `${base}development/`,
    link: 'View the process',
    icon: 'development',
    image: `${base}images/pcb-mmic.jpg`,
  },
  {
    number: '03',
    title: 'SkyBand products',
    text: 'Proprietary RF components and integrated front-end solutions developed for demanding high-frequency systems.',
    href: `${base}products/`,
    link: 'Explore products',
    icon: 'products',
  },
] as const

const disciplines = [
  { number: '01', title: 'System architecture', text: 'Requirements analysis, feasibility studies and signal-chain definition across frequency and power domains.' },
  { number: '02', title: 'RFIC & MMIC design', text: 'Schematic design, PVT simulation and performance optimisation from GHz to mmWave.' },
  { number: '03', title: 'Electromagnetic analysis', text: 'Modelling of critical interconnects, passives, substrate coupling and radiation effects.' },
  { number: '04', title: 'Validation & support', text: 'Design review, measurement guidance and interpretation of on-wafer and bench data.' },
]

const phases = [
  { index: '01', label: 'Define', title: 'Requirements & architecture', text: 'System requirements, signal-chain definition, technology selection and risk assessment.' },
  { index: '02', label: 'Design', title: 'Circuits & implementation', text: 'Circuit design, EM simulation, physical layout and design-rule verification.' },
  { index: '03', label: 'Realise', title: 'Silicon & hardware', text: 'Tape-out, die packaging and evaluation-board assembly for first silicon.' },
  { index: '04', label: 'Validate', title: 'Measure & conclude', text: 'RF measurement, characterisation and final validation against specification.' },
]

const platforms = [
  { label: '01 / CMOS RF-SOI', title: 'Silicon-on-Insulator', text: 'High integration, efficient switching and cost-effective RF front-end solutions for demanding volumes.', tags: ['Integration', 'Switches', 'Front-ends'] },
  { label: '02 / SiGe BiCMOS', title: 'Silicon Germanium', text: 'High-frequency transistor performance for low-noise, mmWave analog and mixed-signal design.', tags: ['mmWave', 'Low noise', 'Mixed-signal'] },
  { label: '03 / GaN MMIC', title: 'Gallium Nitride', text: 'High breakdown voltage and power density for microwave and mmWave power amplification.', tags: ['High power', 'Radar', 'Defence'] },
]

const applications = [
  { number: '01', title: 'Radar & sensing', text: 'RF building blocks and front-end architectures for automotive, industrial and defence detection systems.', icon: 'radar', tags: ['Front-ends', 'Beamforming', 'GaN'] },
  { number: '02', title: 'Satellite communications', text: 'High-frequency amplification and front-end functions for Ka, Q and V-band links and terminals.', icon: 'satellite', tags: ['mmWave', 'RF power', 'SiGe'] },
  { number: '03', title: 'Advanced wireless', text: 'Integrated RF solutions for 5G mmWave infrastructure, massive MIMO and next-generation connected systems.', icon: 'wireless', tags: ['RFIC', 'CMOS SOI', '5G'] },
] as const
---

<BaseLayout
  title="SkyBand Semiconductors — RF & mmWave Engineering"
  description="Specialist RF and mmWave consulting, complete RFIC and MMIC development, and proprietary semiconductor products engineered from specification to silicon."
>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero-image" aria-hidden="true">
      <img src={`${base}images/hero-wafer.jpg`} alt="" width="1376" height="768" fetchpriority="high" decoding="async" />
    </div>

    <CircuitField />

    <div class="container hero-layout">
      <div class="hero-copy">
        <span class="hero-kicker">Specialist semiconductor engineering</span>
        <h1 class="hero-title" id="home-hero-title">Precision RF.<br /><span>Silicon to signal.</span></h1>
        <p class="hero-lead">Specialist consulting, complete RFIC and MMIC project development, and proprietary RF semiconductor products for advanced high-frequency systems.</p>
        <div class="hero-actions">
          <a class="button button--primary" href={`${base}capabilities/`}>Explore capabilities <span aria-hidden="true">↗</span></a>
          <a class="button button--ghost-light" href={`${base}contact/`}>Discuss your project <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-proof">
          <div class="hero-proof-item">
            <span class="hero-proof-value">11 steps</span>
            <span class="hero-proof-label">End-to-end process</span>
          </div>
          <div class="hero-proof-item">
            <span class="hero-proof-value">3 platforms</span>
            <span class="hero-proof-label">Silicon technologies</span>
          </div>
          <div class="hero-proof-item">
            <span class="hero-proof-value">Sub-6 → mmWave</span>
            <span class="hero-proof-label">Frequency coverage</span>
          </div>
          <div class="hero-proof-item">
            <span class="hero-proof-value">RF → Si</span>
            <span class="hero-proof-label">Measured validation</span>
          </div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="signal-board">
          <div class="signal-board-header">
            <span>Integrated RF signal path</span>
            <span class="signal-status">Active</span>
          </div>
          <div class="chip-stage">
            <svg viewBox="0 0 430 270" fill="none" aria-hidden="true">
              <g>
                <path class="chip-pin" d="M40 74h82M40 101h82M40 128h82M40 155h82M40 182h82M308 74h82M308 101h82M308 128h82M308 155h82M308 182h82"></path>
                <rect class="chip-body" x="120" y="48" width="190" height="158" rx="8"></rect>
                <rect class="chip-die" x="154" y="78" width="122" height="96" rx="4"></rect>
                <g class="die-scan">
                  <rect class="die-scan-beam" x="154" y="66" width="122" height="26" rx="6"></rect>
                </g>
                <path class="signal-line" d="M24 128h96M310 128h96"></path>
                <path class="signal-line" d="M215 20v28M215 222v28"></path>
                <path class="signal-line" d="M154 128h122"></path>
                <path class="signal-line" d="M179 101h72M179 155h72"></path>
                <rect class="chip-die" x="190" y="109" width="50" height="38" rx="3"></rect>
                <circle class="signal-node" cx="24" cy="128" r="3"></circle>
                <circle class="signal-node" cx="406" cy="128" r="3"></circle>
                <circle class="signal-node" cx="215" cy="20" r="3"></circle>
                <circle class="signal-node" cx="215" cy="250" r="3"></circle>
              </g>
            </svg>
          </div>
          <div class="signal-board-wave">
            <WaveTrace variant="board" />
          </div>
          <div class="frequency-list">
            <div class="frequency-row">
              <span>Sub-6</span>
              <div class="frequency-track"><div class="frequency-fill" style="--level: 42%"></div></div>
              <span>≤ 6 GHz</span>
            </div>
            <div class="frequency-row">
              <span>Microwave</span>
              <div class="frequency-track"><div class="frequency-fill" style="--level: 72%"></div></div>
              <span>6–30 GHz</span>
            </div>
            <div class="frequency-row">
              <span>mmWave</span>
              <div class="frequency-track"><div class="frequency-fill" style="--level: 100%"></div></div>
              <span>30+ GHz</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-index" aria-hidden="true">01 / RF engineering</div>
  </section>

  <section class="section section--paper" aria-labelledby="engagement-title">
    <div class="container">
      <SectionHeader
        eyebrow="Engagement models"
        title="The right depth of engineering support."
        text="Bring SkyBand into an existing programme, entrust a complete development cycle, or explore a focused product solution."
        id="engagement-title"
      />
      <div class="card-grid card-grid--three" data-reveal-group>
        {engagements.map((engagement) => (
          <article class:list={['premium-card', { 'engagement-card--image': 'image' in engagement, 'premium-card--dark': 'image' in engagement }]}>
            {'image' in engagement && (
              <div class="engagement-card-image">
                <img src={engagement.image} alt="RF integrated circuit board" width="1264" height="848" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="card-number">
              <span>{engagement.number}</span>
              <Icon name={engagement.icon} size={27} />
            </div>
            <h3>{engagement.title}</h3>
            <p>{engagement.text}</p>
            <a class:list={['text-link', { 'text-link--light': 'image' in engagement }]} href={engagement.href}>{engagement.link} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="capability-title">
    <div class="container capability-split">
      <div class="engineering-board" data-reveal>
        <div class="engineering-board-header">
          <span>Engineering scope</span>
          <span class="board-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <div class="discipline-matrix" role="list" aria-label="Engineering scope">
          <div class="matrix-row" role="listitem"><strong>System architecture</strong><div class="matrix-line" style="--strength: 88%" aria-hidden="true"></div></div>
          <div class="matrix-row" role="listitem"><strong>RFIC / MMIC design</strong><div class="matrix-line" style="--strength: 94%" aria-hidden="true"></div></div>
          <div class="matrix-row" role="listitem"><strong>EM analysis</strong><div class="matrix-line" style="--strength: 78%" aria-hidden="true"></div></div>
          <div class="matrix-row" role="listitem"><strong>Layout &amp; verification</strong><div class="matrix-line" style="--strength: 84%" aria-hidden="true"></div></div>
          <div class="matrix-row" role="listitem"><strong>Validation &amp; review</strong><div class="matrix-line" style="--strength: 72%" aria-hidden="true"></div></div>
        </div>
      </div>

      <div data-reveal>
        <span class="eyebrow">Specialist engineering</span>
        <h2 class="h2" id="capability-title" style="margin: 20px 0 24px;">Connected from architecture to measurement.</h2>
        <p class="lead lead--light" style="margin-bottom: 36px;">Focused capability strengthens an engineering team at the point where it creates the most value, while preserving the design intent through every later phase.</p>
        <div class="capability-list">
          {disciplines.map((discipline) => (
            <article class="capability-item">
              <span class="capability-item-number">{discipline.number}</span>
              <div>
                <h3>{discipline.title}</h3>
                <p>{discipline.text}</p>
              </div>
            </article>
          ))}
        </div>
        <a class="button button--primary" href={`${base}capabilities/`} style="margin-top: 32px;">View all capabilities <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="process-title">
    <div class="container">
      <SectionHeader
        eyebrow="Full project development"
        title="One engineering line, from specification to silicon."
        text="A single accountable programme keeps architecture decisions connected to layout choices and measured performance."
        id="process-title"
      />
      <div class="phase-grid" data-reveal-group>
        {phases.map((phase) => (
          <article class="phase-card">
            <span class="phase-index">{phase.index}</span>
            <span class="technical-label">{phase.label}</span>
            <h3>{phase.title}</h3>
            <p>{phase.text}</p>
          </article>
        ))}
      </div>
      <div style="display: flex; justify-content: flex-end; margin-top: 28px;">
        <a class="text-link" href={`${base}development/`}>See the complete 11-step process <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="platform-title">
    <div class="container">
      <SectionHeader
        eyebrow="Technology platforms"
        title="The process follows the application."
        text="Technology selection is guided by frequency, power density, integration and manufacturability—not familiarity."
        id="platform-title"
      />
      <div class="platform-grid" data-reveal-group>
        {platforms.map((platform) => (
          <article class="platform-card">
            <span class="technical-label">{platform.label}</span>
            <h3>{platform.title}</h3>
            <p>{platform.text}</p>
            <div class="tag-row">
              {platform.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="application-title">
    <div class="container">
      <SectionHeader
        eyebrow="Application areas"
        title="Engineered for systems at the edge of performance."
        text="High-frequency applications where signal integrity, power delivery and measurement discipline determine the outcome."
        theme="dark"
        id="application-title"
      />
      <div class="card-grid card-grid--three application-grid" data-reveal-group>
        {applications.map((application) => (
          <article class="premium-card premium-card--dark">
            <div class="card-number">
              <span>{application.number}</span>
              <Icon name={application.icon} size={29} />
            </div>
            <h3>{application.title}</h3>
            <p>{application.text}</p>
            <div class="tag-row" style="margin-top: 28px;">
              {application.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Bring us the difficult RF decision."
    text="Share the frequency range, target performance and programme stage. We will identify the engineering questions that matter first."
  />
</BaseLayout>
